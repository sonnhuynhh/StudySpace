{
  "name": "studyspace",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.19.1",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.1",
    "@supabase/supabase-js": "^2.117.1",
    "@tanstack/react-query": "^5.103.1",
    "expo": "~57.0.24",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/node": "^22.20.3",
    "@types/react": "~19.2.2",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node scripts/start-expo.mjs",
    "start:expo": "node scripts/start-expo.mjs",
    "android": "node scripts/start-expo.mjs --android",
    "ios": "node scripts/start-expo.mjs --ios",
    "web": "node scripts/start-expo.mjs --web",
    "start:default": "expo start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts && node --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "export:web": "expo export --platform web",
    "export:native": "expo export --platform android --platform ios",
    "doctor": "npx expo-doctor",
    "format": "prettier --write App.tsx index.ts scripts src tests",
    "format:check": "prettier --check App.tsx index.ts scripts src tests"
  },
  "private": true
}
